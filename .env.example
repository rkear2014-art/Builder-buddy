# Postgres connection string. The app will not start without this.
# Use the pooled postgres:// address from Prisma Postgres (host often contains "pool").
# A prisma+postgres:// address works for the Prisma CLI only, and the app cannot query it.
# sslmode=require is fine. The app encrypts that connection without requiring a private certificate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/builder_buddy"

# Direct postgres:// address for `prisma migrate deploy` when DATABASE_URL is pooled.
# In Vercel, set this to the direct string from Prisma Postgres (not the pooled one, and not prisma+postgres://).
# Example: postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
DIRECT_URL=""

# At least 32 characters. Generate one with: openssl rand -base64 32
# If this is missing or too short, the tradesperson pages stay closed.
AUTH_SECRET=""

# Optional. Full public URL used in every customer link, share message, and email.
# No trailing slash. This wins over APP_ORIGIN. Set it when a custom domain is live.
# Example: https://app.plastererinredditch.co.uk
APP_BASE_URL=""

# Optional older name for the same public URL. Used only when APP_BASE_URL is unset.
# Example: https://builder-buddy.example.com
APP_ORIGIN=""

# Optional. Branded email via Resend. Leave both unset to keep opening your own email app.
# RESEND_FROM_EMAIL must be an address on a domain you have verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Local demo only. Set to true to show the seeded login on the sign-in page.
SHOW_DEMO_LOGIN="false"

# Password given to the seeded demo user. Defaults to Plaster-tea-1.
SEED_DEMO_PASSWORD="Plaster-tea-1"

# Optional. Full premises lookup. Without these, Find address uses the free postcodes.io
# service to check the postcode and fill town and county. He still types the street.
# The URL should return JSON: { "postcode", "town", "county", "premises": [{ "line1", "line2" }] }.
ADDRESS_LOOKUP_URL=""
ADDRESS_LOOKUP_API_KEY=""

# Optional. If set, the one-time "Create your account" page also asks for this code.
# Leave it unset to set up from a tablet with no extra step. It is ignored once an account exists.
SETUP_TOKEN=""
