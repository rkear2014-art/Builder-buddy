generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  ENQUIRY
  BOOKED
  IN_PROGRESS
  COMPLETE
}

enum BusinessRole {
  OWNER
  MEMBER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum PhotoStage {
  BEFORE
  DURING
  AFTER
}

model Business {
  id            String             @id @default(cuid())
  name          String
  phone         String             @default("")
  email         String             @default("")
  address       String             @default("")
  website       String             @default("")
  tagline       String             @default("")
  accent        String             @default("")
  vatRegistered Boolean            @default(false)
  vatRatePercent Int               @default(20)
  quoteLetter   String             @default("")
  quoteChips    String             @default("")
  invoiceDueDays Int               @default(14)
  quoteValidDays Int               @default(30)
  nextInvoiceNumber Int            @default(1)
  nextQuoteNumber Int              @default(1)
  bankAccountName String           @default("")
  bankSortCode    String           @default("")
  bankAccountNumber String         @default("")
  reviewUrl     String             @default("")
  insurer       String             @default("")
  coverAmount   String             @default("")
  guarantee     String             @default("")
  accreditations String            @default("")
  wastagePercent Int              @default(10)
  logoBytes     Bytes?
  logoMime      String?
  logoUpdatedAt DateTime?
  markBytes     Bytes?
  markMime      String?
  markUpdatedAt DateTime?
  createdAt     DateTime           @default(now())
  users      User[]
  jobs       Job[]
  materials  JobMaterial[]
  signOffs   SignOff[]
  templates  MaterialTemplate[]
  savedItems SavedMaterial[]
  heroes     HeroPhoto[]
  catalogue  CataloguePhoto[]
  invoices   Invoice[]
  payments   Payment[]
  jobPhotos  JobPhoto[]
  labourRates LabourRate[]
  roomMeasures RoomMeasure[]
}

/// A picture for one chooser tile. catalogueKey is a built-in list id or a saved template id.
model CataloguePhoto {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  catalogueKey String
  bytes        Bytes
  mime         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, catalogueKey])
  @@index([businessId])
}

/// A dashboard photo. Several can belong to one business. sourceKey is unique per business so a sample can be added once.
model HeroPhoto {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bytes      Bytes
  mime       String
  caption    String   @default("")
  sourceKey  String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, sourceKey])
  @@index([businessId, sortOrder])
}

/// Single row (id = 1). Once claimed, first-account setup never opens again.
model SetupLock {
  id        Int       @id
  claimed   Boolean   @default(false)
  claimedAt DateTime?
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         BusinessRole       @default(MEMBER)
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  jobs         Job[]
  templates    MaterialTemplate[]
  savedItems   SavedMaterial[]

  @@index([businessId])
}

model Job {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName  String
  address       String
  phone         String
  email         String       @default("")
  trade         String
  description   String
  internalNotes String       @default("")
  showLinePrices Boolean     @default(true)
  depositPence   Int?
  shareActive    Boolean     @default(true)
  surveyDone     String      @default("")
  quoteNumber    Int
  validUntil     DateTime    @db.Date
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  showPhotos     Boolean     @default(false)
  wastagePercent Int?
  measureTypeKey String      @default("")
  measureTypeName String     @default("")
  dayRatePence   Int?
  dayCount       Decimal?    @db.Decimal(6, 2)
  measureSelection String    @default("")
  postcode       String      @default("")
  addressLine1   String      @default("")
  addressLine2   String      @default("")
  town           String      @default("")
  county         String      @default("")
  scheduledDate DateTime     @db.Date
  timeSlot      String
  bookingKind   String       @default("job")
  spanDays      Int          @default(1)
  onDiary       Boolean      @default(true)
  assignedName  String       @default("")
  status        JobStatus
  shareToken    String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  materials     JobMaterial[]
  signOff       SignOff?
  invoices      Invoice[]
  photos        JobPhoto[]
  rooms         RoomMeasure[]

  @@unique([businessId, quoteNumber])
  @@index([userId, scheduledDate])
  @@index([businessId, scheduledDate])
}

model JobMaterial {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  costPricePence Int?
  bought         Boolean @default(false)
  fromMeasure    Boolean @default(false)
  sortOrder      Int     @default(0)

  @@index([jobId])
  @@index([businessId])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  number        Int
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  depositPence  Int?
  vatRegistered Boolean       @default(false)
  vatRatePercent Int          @default(20)
  shareToken    String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([businessId, number])
  @@index([businessId, issueDate])
  @@index([jobId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  sortOrder      Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPence Int
  paidOn      DateTime      @db.Date
  method      PaymentMethod
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
  @@index([businessId, paidOn])
}

model JobPhoto {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bytes      Bytes
  mime       String
  stage      PhotoStage
  createdAt  DateTime   @default(now())

  @@index([jobId, createdAt])
  @@index([businessId])
}

model SignOff {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signerName    String
  signatureData String   @db.Text
  signedAt      DateTime
  snapshot      Json

  @@index([businessId])
}

model MaterialTemplate {
  id         String                 @id @default(cuid())
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  trade     String
  createdAt DateTime               @default(now())
  items     MaterialTemplateItem[]

  @@index([userId, trade])
  @@index([businessId, trade])
}

model MaterialTemplateItem {
  id             String           @id @default(cuid())
  templateId     String
  template       MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal          @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  costPricePence Int?
  coverageBasis  String           @default("")
  coverageAmount Decimal?         @db.Decimal(10, 2)
  sortOrder      Int              @default(0)

  @@index([templateId])
}

model SavedMaterial {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade          String
  name           String
  unit           String
  unitPricePence Int?
  costPricePence Int?
  coverageBasis  String   @default("")
  coverageAmount Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([businessId, trade, name])
  @@index([userId, trade])
  @@index([businessId, trade])
}

/// Labour £ per m² for one job type. Blank stays null. jobTypeKey is a starter id or template:id.
model LabourRate {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobTypeKey       String
  labourPerM2Pence Int?

  @@unique([businessId, jobTypeKey])
  @@index([businessId])
}

/// Saved room or elevation sizes for one job. Prices are not stored here.
model RoomMeasure {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name           String
  mode           String
  lengthM        Decimal? @db.Decimal(8, 2)
  widthM         Decimal? @db.Decimal(8, 2)
  heightM        Decimal? @db.Decimal(8, 2)
  includeWalls   Boolean  @default(true)
  includeCeiling Boolean  @default(false)
  directAreaM2   Decimal? @db.Decimal(10, 2)
  doorCount      Int      @default(0)
  doorAreaM2     Decimal  @default(1.9) @db.Decimal(6, 2)
  windowCount    Int      @default(0)
  windowAreaM2   Decimal  @default(1.5) @db.Decimal(6, 2)
  externalCorners Int     @default(0)
  stopBeadM      Decimal  @default(0) @db.Decimal(8, 2)
  sortOrder      Int      @default(0)

  @@index([jobId])
  @@index([businessId])
}
