generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  ENQUIRY
  BOOKED
  IN_PROGRESS
  COMPLETE
}

enum BusinessRole {
  OWNER
  MEMBER
}

model Business {
  id         String             @id @default(cuid())
  name       String
  createdAt  DateTime           @default(now())
  users      User[]
  jobs       Job[]
  materials  JobMaterial[]
  signOffs   SignOff[]
  templates  MaterialTemplate[]
  savedItems SavedMaterial[]
}

/// Single row (id = 1). Once claimed, first-account setup never opens again.
model SetupLock {
  id        Int       @id
  claimed   Boolean   @default(false)
  claimedAt DateTime?
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         BusinessRole       @default(MEMBER)
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  jobs         Job[]
  templates    MaterialTemplate[]
  savedItems   SavedMaterial[]

  @@index([businessId])
}

model Job {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName  String
  address       String
  phone         String
  email         String       @default("")
  trade         String
  description   String
  internalNotes String       @default("")
  scheduledDate DateTime     @db.Date
  timeSlot      String
  status        JobStatus
  shareToken    String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  materials     JobMaterial[]
  signOff       SignOff?

  @@index([userId, scheduledDate])
  @@index([businessId, scheduledDate])
}

model JobMaterial {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  costPricePence Int?
  bought         Boolean @default(false)
  sortOrder      Int     @default(0)

  @@index([jobId])
  @@index([businessId])
}

model SignOff {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signerName    String
  signatureData String   @db.Text
  signedAt      DateTime
  snapshot      Json

  @@index([businessId])
}

model MaterialTemplate {
  id         String                 @id @default(cuid())
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  trade     String
  createdAt DateTime               @default(now())
  items     MaterialTemplateItem[]

  @@index([userId, trade])
  @@index([businessId, trade])
}

model MaterialTemplateItem {
  id             String           @id @default(cuid())
  templateId     String
  template       MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal          @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  costPricePence Int?
  sortOrder      Int              @default(0)

  @@index([templateId])
}

model SavedMaterial {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade          String
  name           String
  unit           String
  unitPricePence Int?
  costPricePence Int?
  createdAt      DateTime @default(now())

  @@unique([businessId, trade, name])
  @@index([userId, trade])
  @@index([businessId, trade])
}
