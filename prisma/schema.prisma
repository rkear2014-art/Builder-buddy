generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  ENQUIRY
  BOOKED
  IN_PROGRESS
  COMPLETE
}

enum BusinessRole {
  OWNER
  MEMBER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum PhotoStage {
  BEFORE
  DURING
  AFTER
}

/// Sales stage on a quote. Job.status stays the progress after it is won.
enum QuoteStage {
  DRAFT
  QUOTED
  SENT
  WON
  LOST
}

model Business {
  id            String             @id @default(cuid())
  name          String
  phone         String             @default("")
  email         String             @default("")
  address       String             @default("")
  website       String             @default("")
  tagline       String             @default("")
  accent        String             @default("")
  vatRegistered Boolean            @default(true)
  vatRatePercent Int               @default(20)
  vatNumber     String             @default("")
  quoteLetter   String             @default("")
  quoteChips    String             @default("")
  /// Customer terms. Blank uses the standard wording, with this business's name, address and phone.
  terms         String             @default("") @db.Text
  invoiceDueDays Int               @default(14)
  quoteValidDays Int               @default(30)
  /// New jobs copy this. Later changes do not rewrite jobs already saved.
  totalOnlyDefault Boolean         @default(false)
  /// Customer quotes list room sizes and material quantities. Prices stay in the total.
  showQuoteRooms Boolean           @default(true)
  nextInvoiceNumber Int            @default(1)
  nextQuoteNumber Int              @default(1)
  bankAccountName String           @default("")
  bankSortCode    String           @default("")
  bankAccountNumber String         @default("")
  reviewUrl     String             @default("")
  insurer       String             @default("")
  coverAmount   String             @default("")
  guarantee     String             @default("")
  accreditations String            @default("")
  /// Overdue invoice reminders. Days are how long after the due date each one goes out.
  remindersOn   Boolean            @default(true)
  reminderDay1  Int                @default(3)
  reminderDay2  Int                @default(7)
  reminderDay3  Int                @default(14)
  wastagePercent Int              @default(10)
  logoBytes     Bytes?
  logoMime      String?
  logoUpdatedAt DateTime?
  markBytes     Bytes?
  markMime      String?
  markUpdatedAt DateTime?
  createdAt     DateTime           @default(now())
  users      User[]
  jobs       Job[]
  materials  JobMaterial[]
  signOffs   SignOff[]
  templates  MaterialTemplate[]
  savedItems SavedMaterial[]
  heroes     HeroPhoto[]
  catalogue  CataloguePhoto[]
  invoices   Invoice[]
  payments   Payment[]
  jobPhotos  JobPhoto[]
  invoiceReminders InvoiceReminder[]
  labourRates LabourRate[]
  crewRates  CrewRate[]
  jobCrew    JobCrew[]
  roomMeasures RoomMeasure[]
  jobSections JobSection[]
  photoMeasureDays PhotoMeasureDay[]
}

/// A picture for one chooser tile. catalogueKey is a built-in list id or a saved template id.
model CataloguePhoto {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  catalogueKey String
  bytes        Bytes
  mime         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, catalogueKey])
  @@index([businessId])
}

/// A dashboard photo. Several can belong to one business. sourceKey is unique per business so a sample can be added once.
model HeroPhoto {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bytes      Bytes
  mime       String
  caption    String   @default("")
  sourceKey  String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, sourceKey])
  @@index([businessId, sortOrder])
}

/// Single row (id = 1). Once claimed, first-account setup never opens again.
model SetupLock {
  id        Int       @id
  claimed   Boolean   @default(false)
  claimedAt DateTime?
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         BusinessRole       @default(MEMBER)
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  jobs         Job[]
  templates    MaterialTemplate[]
  savedItems   SavedMaterial[]

  @@index([businessId])
}

model Job {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName  String
  address       String
  phone         String
  email         String       @default("")
  trade         String
  description   String
  internalNotes String       @default("")
  showLinePrices Boolean     @default(true)
  depositPence   Int?
  shareActive    Boolean     @default(true)
  surveyDone     String      @default("")
  quoteNumber    Int
  validUntil     DateTime    @db.Date
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  showPhotos     Boolean     @default(false)
  wastagePercent Int?
  measureTypeKey String      @default("")
  measureTypeName String     @default("")
  dayRatePence   Int?
  dayCount       Decimal?    @db.Decimal(6, 2)
  measureSelection String    @default("")
  postcode       String      @default("")
  addressLine1   String      @default("")
  addressLine2   String      @default("")
  town           String      @default("")
  county         String      @default("")
  scheduledDate DateTime     @db.Date
  timeSlot      String
  bookingKind   String       @default("job")
  spanDays      Int          @default(1)
  onDiary       Boolean      @default(true)
  assignedName  String       @default("")
  /// Turns VAT off for this quote even when the business is VAT registered.
  omitVat       Boolean      @default(false)
  /// Draft, quoted, sent, won or lost. Separate from the diary progress in status.
  quoteStage    QuoteStage   @default(QUOTED)
  /// Customer quote, invoice and link show one total. The desk still lists materials.
  totalOnly     Boolean      @default(false)
  /// Whole-job price in pence, before VAT. Null uses the materials total.
  fixedPricePence Int?
  status        JobStatus
  shareToken    String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  materials     JobMaterial[]
  signOff       SignOff?
  invoices      Invoice[]
  photos        JobPhoto[]
  rooms         RoomMeasure[]
  crew          JobCrew[]
  sections      JobSection[]

  @@unique([businessId, quoteNumber])
  @@index([userId, scheduledDate])
  @@index([businessId, scheduledDate])
}

model JobMaterial {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  costPricePence Int?
  bought         Boolean @default(false)
  fromMeasure    Boolean @default(false)
  sortOrder      Int     @default(0)
  sectionId      String
  section        JobSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([businessId])
  @@index([sectionId])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  number        Int
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  depositPence  Int?
  vatRegistered Boolean       @default(true)
  vatRatePercent Int          @default(20)
  /// One line for the work, with no material quantities or unit prices.
  totalOnly     Boolean       @default(false)
  shareToken    String        @unique
  /// Stops further reminders on this invoice. Marking it paid stops them as well.
  remindersPaused Boolean     @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]
  payments      Payment[]
  reminders     InvoiceReminder[]

  @@unique([businessId, number])
  @@index([businessId, issueDate])
  @@index([jobId])
}

/// One row per reminder step. The unique step stops the same reminder being sent twice.
model InvoiceReminder {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  step       Int
  /// EMAIL, WHATSAPP, TEXT, or MAIL.
  channel    String
  sentAt     DateTime @default(now())

  @@unique([invoiceId, step])
  @@index([businessId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  sortOrder      Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPence Int
  paidOn      DateTime      @db.Date
  method      PaymentMethod
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
  @@index([businessId, paidOn])
}

model JobPhoto {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bytes      Bytes
  mime       String
  stage      PhotoStage
  createdAt  DateTime   @default(now())

  @@index([jobId, createdAt])
  @@index([businessId])
}

model SignOff {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signerName    String
  signatureData String   @db.Text
  signedAt      DateTime
  /// True when this signature included agreement to the terms.
  termsAgreed   Boolean  @default(false)
  /// The terms wording the customer agreed to. Empty on older signatures.
  termsText     String   @default("") @db.Text
  termsAgreedAt DateTime?
  snapshot      Json

  @@index([businessId])
}

model MaterialTemplate {
  id         String                 @id @default(cuid())
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  trade     String
  createdAt DateTime               @default(now())
  items     MaterialTemplateItem[]

  @@index([userId, trade])
  @@index([businessId, trade])
}

model MaterialTemplateItem {
  id             String           @id @default(cuid())
  templateId     String
  template       MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal          @db.Decimal(10, 2)
  unit           String
  unitPricePence Int?
  costPricePence Int?
  coverageBasis  String           @default("")
  coverageAmount Decimal?         @db.Decimal(10, 2)
  sortOrder      Int              @default(0)

  @@index([templateId])
}

model SavedMaterial {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade          String
  name           String
  unit           String
  unitPricePence Int?
  costPricePence Int?
  coverageBasis  String   @default("")
  coverageAmount Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([businessId, trade, name])
  @@index([userId, trade])
  @@index([businessId, trade])
}

/// Usual crew rates for the business. Blank stays null so no price is invented.
model CrewRate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       String
  basis      String   @default("day")
  ratePence  Int?

  @@unique([businessId, role])
  @@index([businessId])
}

/// People on one job section. Their pay is added together on the Labour line.
model JobCrew {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sectionId  String
  section    JobSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  role       String
  count      Int      @default(0)
  basis      String   @default("day")
  ratePence  Int?

  @@unique([sectionId, role])
  @@index([businessId])
  @@index([jobId])
  @@index([sectionId])
}

/// One piece of work on a quote, such as skimming a lounge or rendering a wall.
model JobSection {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sortOrder       Int      @default(0)
  title           String   @default("")
  typeKey         String   @default("")
  /// Price for this job before VAT. Null uses its materials and labour.
  fixedPricePence Int?
  dayCount        Decimal? @db.Decimal(6, 2)
  /// Calculator choices for this job, so reopening the measure does not use another job's list.
  measureSelection String   @default("")
  materials       JobMaterial[]
  rooms           RoomMeasure[]
  crew            JobCrew[]

  @@index([businessId])
  @@index([jobId, sortOrder])
}

/// Labour £ per m² for one job type. Blank stays null. jobTypeKey is a starter id or template:id.
model LabourRate {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobTypeKey       String
  labourPerM2Pence Int?

  @@unique([businessId, jobTypeKey])
  @@index([businessId])
}

/// Saved room or elevation sizes for one job. Prices are not stored here.
model RoomMeasure {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name           String
  mode           String
  lengthM        Decimal? @db.Decimal(8, 2)
  widthM         Decimal? @db.Decimal(8, 2)
  heightM        Decimal? @db.Decimal(8, 2)
  includeWalls   Boolean  @default(true)
  includeCeiling Boolean  @default(false)
  directAreaM2   Decimal? @db.Decimal(10, 2)
  doorCount      Int      @default(0)
  doorAreaM2     Decimal  @default(1.9) @db.Decimal(6, 2)
  windowCount    Int      @default(0)
  windowAreaM2   Decimal  @default(1.5) @db.Decimal(6, 2)
  externalCorners Int     @default(0)
  stopBeadM      Decimal  @default(0) @db.Decimal(8, 2)
  sortOrder      Int      @default(0)
  sectionId      String
  section        JobSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([businessId])
  @@index([sectionId])
}

/// How many photo measures a business has used on a London day. Photos themselves are not kept.
model PhotoMeasureDay {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD in Europe/London.
  day        String
  count      Int      @default(0)

  @@unique([businessId, day])
  @@index([businessId])
}
